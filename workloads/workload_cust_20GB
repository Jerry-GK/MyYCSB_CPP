# Yahoo! Cloud System Benchmark
# Workload Cust: customized

# Recommend: (operationcount * warmup_ration * avgscanlen) / (recordcount * hot_data_ratio) >= k (k >= 2)

recordcount=20000000
operationcount=4000000
hot_data_ratio=0.05
warmup_ratio=0.05
insertorder=random
# insertorder=hashed
# insertorder=ordered

# threadcount=1
# threadcount=4

workload=com.yahoo.ycsb.workloads.CoreWorkload

zeropadding=24
fieldcount=1
fieldlength=1024

readallfields=true
writeallfields=true

# readproportion=0.1
# updateproportion=0.3
# scanproportion=0.5
# insertproportion=0.1

readproportion=0
updateproportion=0
scanproportion=1.0
insertproportion=0


requestdistribution=zipfian
# requestdistribution=uniform
# zipfian_const=2.0

# minscanlength=40000
# maxscanlength=40000

minscanlength=100
maxscanlength=100

scanlengthdistribution=uniform


